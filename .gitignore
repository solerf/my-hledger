!data/
data/*
!data/.gitkeep

# Global gitignore has `**/project/` (sbt convention); override for sbt build inputs.
!app/project/
app/project/*
!app/project/build.properties
!app/project/plugins.sbt

**/mock.journal

# Frontend pnpm artifacts; vendored JS is generated by `pnpm run vendor`.
app/frontend/node_modules/
app/frontend/src/main/resources/vendor/

# Scala.js linker output (written here by frontend/fastLinkJS via
# scalaJSLinkerOutputDirectory in build.sbt). The linker owns this dir
# exclusively — it wipes contents on every link.
app/frontend/src/main/resources/js/

