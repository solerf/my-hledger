#!/usr/bin/env bash
# Run the app stack locally against the mock journal.
#
#   hledger-web  -> 127.0.0.1:5000  (data gateway, fed by mock.journal)
#   sbtx backend -> 127.0.0.1:8080  (Scala viewer; serves frontend assets)
#
# The frontend is linked once via fastLinkJS before the backend boots.
# Re-run this script to pick up frontend changes, or run
# `./sbtx ~frontend/fastLinkJS` in a second shell for hot relinking.

set -euo pipefail

cd "$(dirname "$0")"

JOURNAL="${HLEDGER_JOURNAL:-$PWD/mock.journal}"
HLEDGER_WEB_PORT="${HLEDGER_WEB_PORT:-5000}"

if ! command -v hledger-web >/dev/null 2>&1; then
  echo "error: hledger-web not found on PATH" >&2
  exit 1
fi

echo ">>> linking frontend (fastLinkJS)"
./sbtx frontend/fastLinkJS

assets_dir="frontend/target/scala-3.3.4/app-frontend-fastopt"
cp -f frontend/src/main/resources/index.html "$assets_dir/"

echo ">>> starting hledger-web on 127.0.0.1:$HLEDGER_WEB_PORT  (journal: $JOURNAL)"
hledger-web --serve-api -f "$JOURNAL" \
  --host 127.0.0.1 --port "$HLEDGER_WEB_PORT" &
hledger_web_pid=$!
trap 'kill "$hledger_web_pid" 2>/dev/null || true' EXIT INT TERM

echo ">>> starting backend on 127.0.0.1:8080"
APP_ASSETS_DIR="$assets_dir" \
HLEDGER_WEB_URL="http://localhost:$HLEDGER_WEB_PORT" \
  ./sbtx backend/run
