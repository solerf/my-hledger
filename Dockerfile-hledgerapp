# ---------- Stage 1: build the Go binaries (viewer app + CLI orchestrator) ----------
FROM golang:1.26-alpine AS go-build

# --- Viewer app ---
WORKDIR /src/app
COPY app/go.mod app/go.sum ./
RUN go mod download
COPY app/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/my-hledger-app .

# --- CLI orchestrator ---
WORKDIR /src/cli
COPY cli/go.mod cli/go.sum ./
RUN go mod download
COPY cli/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/my-hledger .

# ---------- Stage 1b: vendor frontend JS deps with pnpm (chart.js, bootstrap) ----------
FROM node:22-alpine AS frontend-vendor

RUN corepack enable
WORKDIR /src/frontend
COPY app/package.json ./
# pnpm-lock.yaml is optional; copy it if present so the build is reproducible.
COPY app/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile || pnpm install
# `postinstall` already runs the vendor script, but re-run to be explicit.
RUN pnpm run vendor

# ---------- Stage 2: runtime: alpine + hledger + Go binaries ----------
FROM alpine:3.22

RUN apk update && apk upgrade && \
    apk add --no-cache bash hledger hledger-web

WORKDIR /opt
RUN mkdir -p /opt/hledger_data /opt/app/assets

# Frontend assets: stylesheet, vendored JS (chart.js, bootstrap), page scripts.
COPY app/assets/app.css /opt/app/assets/app.css
COPY app/assets/css /opt/app/assets/css
COPY app/assets/js /opt/app/assets/js
COPY --from=frontend-vendor /src/frontend/assets/vendor /opt/app/assets/vendor

# Go binaries: the viewer app and the CLI orchestrator.
COPY --from=go-build /out/my-hledger-app /usr/local/bin/my-hledger-app
COPY --from=go-build /out/my-hledger /usr/local/bin/my-hledger

# Entrypoint script — backgrounds hledger-web on :5000, execs the app on :8081.
COPY app/docker-entrypoint.sh /opt/app/docker-entrypoint.sh
RUN chmod +x /opt/app/docker-entrypoint.sh

# HLEDGER_JOURNAL is intentionally NOT set — it must be supplied at `docker run`
# time (e.g. `-e HLEDGER_JOURNAL=/opt/hledger_data/2026.hledger.journal`) so the
# image stays journal-agnostic.
ENV HLEDGER_WEB_URL=http://localhost:5000 \
    APP_ASSETS_DIR=/opt/app/assets \
    HOME=/tmp

# Only 8081 is published; 5000 (hledger-web) is internal.
EXPOSE 8081

ENTRYPOINT ["/opt/app/docker-entrypoint.sh"]
